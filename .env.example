# ProPrint V10 environment template
# Copy this file to .env.local for local development.
# Never commit real credentials or secrets.

# Required: Supabase project URL and publishable/anon key.
# These are intentionally the browser-safe project credentials used with RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Optional request-delivery integrations. Leave unset for demo mode.
# Never place real values in this example file.
PROPRINT_REQUEST_WEBHOOK_URL=
RESEND_API_KEY=
PROPRINT_REQUEST_TO_EMAIL=
PROPRINT_REQUEST_FROM_EMAIL=
